# AgentLens sample policy
#
# Matching semantics: path / process / command filters are case-insensitive
# prefix matches. Wildcards are not supported and are rejected by the policy
# compiler. DOS drive-letter paths are converted to native device paths when
# the text policy is compiled on the target machine. Use the full image path
# prefix for process filters.

mode = control

deny file.write
    process = C:\Program Files\AgentLens\agent.exe
    path = C:\Users\Public\Desktop\

deny registry.set
    process = C:\Program Files\AgentLens\agent.exe
    path = \REGISTRY\MACHINE\SOFTWARE\Microsoft\Windows\CurrentVersion\Run

deny network.connect
    process = C:\Program Files\AgentLens\agent.exe
