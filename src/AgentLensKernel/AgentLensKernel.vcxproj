    <UseDebugLibraries>false</UseDebugLibraries>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <PropertyGroup>
    <OutDir>$(SolutionDir)build\AgentLensKernel\$(Platform)\$(Configuration)\</OutDir>
    <IntDir>$(SolutionDir)build\obj\AgentLensKernel\$(Platform)\$(Configuration)\</IntDir>
    <SignMode>Off</SignMode>
    <AgentLensSpectreMitigation Condition="'$(AgentLensSpectreMitigation)' == '' and Exists('$(VC_LibraryPath_VC_Desktop_CurrentPlatform_spectre)')">true</AgentLensSpectreMitigation>
